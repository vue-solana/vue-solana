    "llms": "node scripts/generate-llms.mjs",
    "preview": "nuxt preview"
  },
  "dependencies": {
    "@nuxt/content": "^3.14.0",
    "@nuxt/image": "2.0.0",
    "@nuxt/ui": "^4.8.1",
    "@nuxtjs/seo": "5.3.2",
    "@resvg/resvg-js": "^2.6.2",
    "@vercel/analytics": "^2.0.1",
    "@vue-solana/nuxt": "0.6.7",
    "nuxt": "^4.4.6",
    "satori": "^0.26.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.8.3",
    "vue": "^3.5.34",
    "vue-router": "^5.0.7"
  }
